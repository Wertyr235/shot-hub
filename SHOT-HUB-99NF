-- ========================== ФУНКЦИИ ПОИСКА МОДЕЛЕЙ ==========================

local function findAllModels(modelName)
    local models = {}
    
    local function searchContainer(container)
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Model") then
                if child.Name == modelName then
                    table.insert(models, child)
                else
                    searchContainer(child)
                end
            elseif child:IsA("Folder") then
                searchContainer(child)
            end
        end
    end
    
    searchContainer(Workspace)
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == modelName then
            local isDuplicate = false
            for _, existingModel in ipairs(models) do
                if existingModel == obj then
                    isDuplicate = true
                    break
                end
            end
            if not isDuplicate then
                table.insert(models, obj)
            end
        end
    end
    
    return models
end

local function teleportModelToPlayer(model)
    if not model or not model.Parent then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local targetPos = root.Position + Vector3.new(0, 3, 2)
    
    local primaryPart = model.PrimaryPart
    
    if primaryPart then
        local newCFrame = CFrame.new(targetPos)
        model:SetPrimaryPartCFrame(newCFrame)
    else
        for _, child in ipairs(model:GetDescendants()) do
            if child:IsA("BasePart") then
                child.CFrame = CFrame.new(targetPos)
                break
            end
        end
    end
end

local function teleportModelToPosition(model, position)
    if not model or not model.Parent then return end
    
    local primaryPart = model.PrimaryPart
    
    if primaryPart then
        local newCFrame = CFrame.new(position)
        model:SetPrimaryPartCFrame(newCFrame)
    else
        for _, child in ipairs(model:GetDescendants()) do
            if child:IsA("BasePart") then
                child.CFrame = CFrame.new(position)
                break
            end
        end
    end
end

local function teleportAllModels(modelName)
    local models = findAllModels(modelName)
    local count = 0
    
    for _, model in ipairs(models) do
        if model and model.Parent then
            teleportModelToPlayer(model)
            count = count + 1
        end
    end
    
    print("[ITEM HUB] Телепортировано моделей: " .. count)
    return count
end

-- ========================== ПРОКАЧКА КОСТРА ==========================

local function teleportPlayerToPosition(position)
    local char = LocalPlayer.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    root.CFrame = CFrame.new(position)
    root.Velocity = Vector3.new(0, 0, 0)
    root.RotVelocity = Vector3.new(0, 0, 0)
end

local function upgradeCampfire()
    print("[ITEM HUB] Начинаю прокачку костра...")
    
    -- Телепортируем игрока к костру
    teleportPlayerToPosition(CAMPFIRE_POS)
    task.wait(0.5)
    
    local totalTeleported = 0
    
    -- Телепортируем ресурсы по одному
    for _, resourceName in ipairs(campfireResources) do
        local models = findAllModels(resourceName)
        
        for _, model in ipairs(models) do
            if model and model.Parent then
                teleportModelToPosition(model, CAMPFIRE_POS + Vector3.new(0, 3, 0))
                totalTeleported = totalTeleported + 1
                print("[ITEM HUB] Телепортирован: " .. resourceName)
                task.wait(0.5) -- Пауза 0.5 секунд между ресурсами
            end
        end
    end
    
    print("[ITEM HUB] Прокачка завершена! Телепортировано: " .. totalTeleported)
    return totalTeleported
end

local function throwResources()
    print("[ITEM HUB] Начинаю закидывание ресурсов...")
    
    -- Телепортируем игрока к точке сброса
    teleportPlayerToPosition(THROW_POS)
    task.wait(0.5)
    
    local totalTeleported = 0
    
    -- Телепортируем ресурсы по одному
    for _, resourceName in ipairs(throwResources) do
        local models = findAllModels(resourceName)
        
        for _, model in ipairs(models) do
            if model and model.Parent then
                teleportModelToPosition(model, THROW_POS + Vector3.new(0, -2, 0))
                totalTeleported = totalTeleported + 1
                print("[ITEM HUB] Закинут: " .. resourceName)
                task.wait(0.5) -- Пауза 0.5 секунд между ресурсами
            end
        end
    end
    
    print("[ITEM HUB] Закидывание завершено! Телепортировано: " .. totalTeleported)
    return totalTeleported
end

-- ========================== АВТО ТЕЛЕПОРТ ==========================

local function startAutoTeleport(modelName)
    if teleportConnection then return end
    teleportEnabled = true
    
    teleportConnection = RunService.Heartbeat:Connect(function()
        if not teleportEnabled then return end
        
        local models = findAllModels(modelName)
        for _, model in ipairs(models) do
            if model and model.Parent then
                teleportModelToPlayer(model)
            end
        end
    end)
end

local function stopAutoTeleport()
    teleportEnabled = false
    if teleportConnection then
        teleportConnection:Disconnect()
        teleportConnection = nil
    end
end

