    Page.Size = UDim2.new(1, -20, 1, -20)
    Page.Position = UDim2.new(0, 10, 0, 10)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 2
    Page.Visible = false
    Page.Parent = Container
    
    local PageLayout = Instance.new("UIListLayout")
    PageLayout.Padding = UDim.new(0, 8)
    PageLayout.Parent = Page
    
    if isDefault then
        TabBtn.BackgroundColor3 = Color3.fromRGB(35, 30, 45)
        TabBtn.TextColor3 = Purple
        Page.Visible = true
    else
        TabBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        TabBtn.TextColor3 = Color3.fromRGB(140, 140, 150)
    end
    
    TabBtn.MouseButton1Click:Connect(function()
        for _, btn in ipairs(allTabs) do
            btn.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
            btn.TextColor3 = Color3.fromRGB(140, 140, 150)
        end
        for _, pg in ipairs(allPages) do
            pg.Visible = false
        end
        TabBtn.BackgroundColor3 = Color3.fromRGB(35, 30, 45)
        TabBtn.TextColor3 = Purple
        Page.Visible = true
    end)
    
    table.insert(allTabs, TabBtn)
    table.insert(allPages, Page)
    return Page
end

