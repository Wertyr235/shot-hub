-- ========================== ФУНКЦИИ ==========================

local function loadScriptFromUrl(url)
    local success, result = pcall(function()
        local response = game:HttpGet(url)
        return response
    end)
    
    if success then
        return result
    else
        warn("[SCRIPT HUB] Ошибка загрузки: " .. tostring(result))
        return nil
    end
end

local function injectScript(scriptCode)
    local success, result = pcall(function()
        local func = loadstring(scriptCode)
        if func then
            return func()
        else
            error("Не удалось загрузить скрипт")
        end
    end)
    
    if success then
        print("[SCRIPT HUB] Скрипт успешно загружен!")
        return true
    else
        warn("[SCRIPT HUB] Ошибка инжекта: " .. tostring(result))
        return false
    end
end

local function executeScript(scriptData)
    if not scriptData then return end
    
    print("[SCRIPT HUB] Загрузка: " .. scriptData.name)
    
    local scriptCode = loadScriptFromUrl(scriptData.url)
    if scriptCode then
        injectScript(scriptCode)
    end
end

