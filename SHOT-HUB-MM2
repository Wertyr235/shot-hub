-- ========================== FLING (СКОРОСТЬ 1000) ==========================

local function flingPlayer(targetPlayer)
    if not targetPlayer then return end
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if not root or not hum then return end
    
    local targetRoot = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    
    local originalPos = root.CFrame
    hum.PlatformStand = true
    
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e7, 1e7, 1e7)
    bv.Velocity = Vector3.new(99999, 99999, 99999)
    bv.Parent = root
    
    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
    bav.AngularVelocity = Vector3.new(0, 99999, 0)
    bav.Parent = root
    
    local speed = 30
    local distance = 6
    local startTime = os.clock()
    local flingTime = 3
    
    while targetRoot and targetRoot.Parent and root and bv.Parent and os.clock() - startTime < flingTime do
        local elapsed = os.clock() - startTime
        local offset = math.sin(elapsed * speed) * distance
        
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        
        root.CFrame = CFrame.new(targetRoot.Position) * CFrame.new(0, 0, offset) * CFrame.Angles(math.rad(90), 0, 0)
        RunService.Heartbeat:Wait()
    end
    
    pcall(function() bv:Destroy() end)
    pcall(function() bav:Destroy() end)
    hum.PlatformStand = false
    
    root.Velocity = Vector3.new(0, 0, 0)
    root.RotVelocity = Vector3.new(0, 0, 0)
    root.CFrame = originalPos
    root.Velocity = Vector3.new(0, 0, 0)
    root.RotVelocity = Vector3.new(0, 0, 0)
    
    local anchor = Instance.new("BodyVelocity")
    anchor.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    anchor.Velocity = Vector3.new(0, 0, 0)
    anchor.Parent = root
    
    task.wait(1)
    pcall(function() anchor:Destroy() end)
    
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then part.CanCollide = true end
    end
    
    root.Velocity = Vector3.new(0, 0, 0)
    root.RotVelocity = Vector3.new(0, 0, 0)
end

local function flingMurderer()
    flingPlayer(findMurderer())
end

local function flingSheriff()
    flingPlayer(getSheriff())
end

local function flingSelected()
    flingPlayer(selectedFlingTarget)
end

-- ========================== GUNDROP ==========================

local function findGunDropPart()
    for _, model in ipairs(Workspace:GetDescendants()) do
        if model:IsA("Model") then
            local gunDropPart = model:FindFirstChild("GunDrop")
            if gunDropPart and gunDropPart:IsA("BasePart") then
                return gunDropPart
            end
            
            for _, child in ipairs(model:GetChildren()) do
                if child.Name == "GunDrop" and child:IsA("BasePart") then
                    return child
                end
            end
        end
    end
    return nil
end

local function pickupGunDrop()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    local gunDropPart = findGunDropPart()
    
    if not gunDropPart then return end
    
    local originalPos = root.CFrame
    root.CFrame = CFrame.new(gunDropPart.Position + Vector3.new(0, 3, 0))
    task.wait(0.5)
    root.Velocity = Vector3.new(0, 0, 0)
    root.CFrame = originalPos
    root.Velocity = Vector3.new(0, 0, 0)
end

local function startAutoPickup()
    if autoPickupConnection then return end
    autoPickupEnabled = true
    
    autoPickupConnection = RunService.RenderStepped:Connect(function()
        if not autoPickupEnabled then return end
        
        if tick() - lastPickupTime >= 1 then
            lastPickupTime = tick()
            
            local gunDropPart = findGunDropPart()
            if gunDropPart then
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local originalPos = root.CFrame
                    root.CFrame = CFrame.new(gunDropPart.Position + Vector3.new(0, 3, 0))
                    task.wait(0.3)
                    root.Velocity = Vector3.new(0, 0, 0)
                    root.CFrame = originalPos
                    root.Velocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end)
end

local function stopAutoPickup()
    autoPickupEnabled = false
    if autoPickupConnection then
        autoPickupConnection:Disconnect()
        autoPickupConnection = nil
    end
end

