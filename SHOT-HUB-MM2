local function updatePlayerList()
    for _, child in ipairs(PlayerList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local yPos = 0
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local playerButton = Instance.new("TextButton")
            playerButton.Size = UDim2.new(1, -10, 0, 35)
            playerButton.Position = UDim2.new(0, 5, 0, yPos)
            playerButton.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
            playerButton.BorderSizePixel = 0
            playerButton.Text = player.Name
            playerButton.TextColor3 = WhiteText
            playerButton.Font = Enum.Font.Gotham
            playerButton.TextSize = 13
            playerButton.Parent = PlayerList
            
            playerButton.MouseButton1Click:Connect(function()
                selectedFlingTarget = player
                PlayerDropdown.Text = player.Name
                PlayerList.Visible = false
            end)
            
            yPos = yPos + 40
        end
    end
    PlayerList.CanvasSize = UDim2.new(0, 0, 0, yPos)
end

