Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        if espEnabled then
            task.wait(0.5)
            if player.Character and isPlayerCharacter(player.Character) then
                createESP(player)
            end
        end
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    removeESP(player)
    if rememberedSheriff == player then
        rememberedSheriff = nil
    end
    if selectedFlingTarget == player then
        selectedFlingTarget = nil
        PlayerDropdown.Text = "Select Player to Fling"
    end
end)

