-- ========================== РОЛИ ==========================

local function isPlayerCharacter(character)
    if not character then return false end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    return true
end

local function isMurderer(player)
    local character = player.Character
    if not character then return false end
    if not isPlayerCharacter(character) then return false end
    for _, child in pairs(character:GetChildren()) do
        if child:IsA("Folder") then
            return true
        end
    end
    return false
end

local function findMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isMurderer(player) then
            return player
        end
    end
    return nil
end

local function findSheriffByWeapon()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not isMurderer(player) then
            local backpack = player:FindFirstChild("Backpack")
            if backpack then
                for _, tool in pairs(backpack:GetChildren()) do
                    local name = tool.Name:lower()
                    if name:find("gun") or name:find("pistol") then
                        return player
                    end
                end
            end
            
            local character = player.Character
            if character then
                for _, tool in pairs(character:GetChildren()) do
                    if tool:IsA("Tool") then
                        local name = tool.Name:lower()
                        if name:find("gun") or name:find("pistol") then
                            return player
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function updateRememberedSheriff()
    local murderer = findMurderer()
    
    if murderer then
        local sheriff = findSheriffByWeapon()
        if sheriff then
            rememberedSheriff = sheriff
            lastMurdererState = true
        end
    else
        if lastMurdererState then
            rememberedSheriff = nil
            lastMurdererState = false
        end
    end
end

local function getSheriff()
    local sheriff = findSheriffByWeapon()
    if sheriff then
        rememberedSheriff = sheriff
        return sheriff
    end
    return rememberedSheriff
end

-- ========================== ESP ==========================

local function getRole(player)
    local character = player.Character
    if not character then return "Unknown" end
    
    for _, child in pairs(character:GetChildren()) do
        if child:IsA("Folder") then
            return "Murderer"
        end
    end
    
    if rememberedSheriff == player then
        return "Sheriff"
    end
    
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            local name = tool.Name:lower()
            if name:find("gun") or name:find("pistol") then
                return "Sheriff"
            end
        end
    end
    
    for _, tool in pairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            if name:find("gun") or name:find("pistol") then
                return "Sheriff"
            end
        end
    end
    
    return "Innocent"
end

local function removeESP(player)
    if espObjects[player] then
        if espObjects[player].Highlight then pcall(function() espObjects[player].Highlight:Destroy() end) end
        if espObjects[player].Billboard then pcall(function() espObjects[player].Billboard:Destroy() end) end
        espObjects[player] = nil
    end
end

local function createESP(player)
    if not player or player == LocalPlayer then return end
    removeESP(player)
    
    local character = player.Character
    if not character or not isPlayerCharacter(character) then return end
    
    local head = character:FindFirstChild("Head")
    if not head then return end
    
    local role = getRole(player)
    
    local highlight = Instance.new("Highlight")
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 120, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextStrokeTransparency = 0
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 16
    
    if role == "Murderer" then
        highlight.FillColor = Red
        highlight.OutlineColor = NeonRed
        textLabel.Text = "🔪 MURDERER"
        textLabel.TextColor3 = Red
    elseif role == "Sheriff" then
        highlight.FillColor = Blue
        highlight.OutlineColor = NeonBlue
        textLabel.Text = "🔫 SHERIFF"
        textLabel.TextColor3 = Blue
    else
        highlight.FillColor = Green
        highlight.OutlineColor = NeonGreen
        textLabel.Text = "😇 INNOCENT"
        textLabel.TextColor3 = Green
    end
    
    highlight.Parent = character
    textLabel.Parent = billboard
    
    espObjects[player] = {Highlight = highlight, Billboard = billboard}
end

local function clearAllESP()
    for player in pairs(espObjects) do
        removeESP(player)
    end
end

local function scanPlayers()
    updateRememberedSheriff()
    clearAllESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character and isPlayerCharacter(character) then
                createESP(player)
            end
        end
    end
end

local espConnection = nil
local lastScanTime = 0

local function startESP()
    if espConnection then return end
    espEnabled = true
    scanPlayers()
    espConnection = RunService.RenderStepped:Connect(function()
        if not espEnabled then return end
        if tick() - lastScanTime >= 5 then
            scanPlayers()
            lastScanTime = tick()
        end
    end)
end

local function stopESP()
    espEnabled = false
    if espConnection then
        espConnection:Disconnect()
        espConnection = nil
    end
    clearAllESP()
end

-- ========================== FLY ==========================

local function startFly()
    if flyConnection then return end
    
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if not root or not hum then return end
    
    flyEnabled = true
    hum.PlatformStand = true
    
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = root
    
    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.D = 100
    bodyGyro.P = 9000
    bodyGyro.Parent = root
    
    flyConnection = RunService.RenderStepped:Connect(function()
        if not flyEnabled then return end
        
        local currentChar = LocalPlayer.Character
        local currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
        if not currentRoot then return end
        
        local camera = Workspace.CurrentCamera
        if camera then
            bodyGyro.CFrame = camera.CFrame
        end
        
        local moveDirection = Vector3.new(0, 0, 0)
        
        if camera then
            local cameraCFrame = camera.CFrame
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + cameraCFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - cameraCFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - cameraCFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + cameraCFrame.RightVector end
        end
        
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDirection = moveDirection - Vector3.new(0, 1, 0) end
        
        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit
        end
        
        bodyVelocity.Velocity = moveDirection * 50
    end)
end

local function stopFly()
    flyEnabled = false
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    
    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if root then
            for _, child in ipairs(root:GetChildren()) do
                if child:IsA("BodyVelocity") or child:IsA("BodyGyro") then
                    child:Destroy()
                end
            end
            root.Velocity = Vector3.new(0, 0, 0)
        end
        
        if hum then
            hum.PlatformStand = false
        end
    end
end

